{
  "name": "copy-all-note",
  "version": "0.1.1",
  "private": true,
  "description": "An Obsidian plugin that copies the current note's raw Markdown from a native view-header action.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "npm run typecheck && npm test && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run build && npm run release:verify",
    "release:package": "node scripts/package-release.mjs",
    "release:prepare": "npm run check && npm run release:package",
    "release:verify": "node scripts/verify-release.mjs"
  },
  "keywords": [
    "obsidian",
    "clipboard",
    "markdown"
  ],
  "author": "Logan McKinley Juhl",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LoganJuhl/copy-all-note.git"
  },
  "homepage": "https://github.com/LoganJuhl/copy-all-note#readme",
  "bugs": {
    "url": "https://github.com/LoganJuhl/copy-all-note/issues"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "esbuild": "0.28.2",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.0",
    "globals": "^17.13.0",
    "jiti": "^2.6.1",
    "jsdom": "^30.1.1",
    "obsidian": "latest",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.10"
  }
}
